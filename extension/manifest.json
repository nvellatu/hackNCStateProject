{
  "manifest_version": 3,
  "name": "Streetlight Ledger",
  "version": "0.2.0",
  "description": "Shows third-party domains a page contacts (tracking intensity).",
  "permissions": ["tabs", "webRequest", "cookies"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Streetlight Ledger"
  },
  "icons": {
    "128": "DetectiveCookie.png"
  }
}