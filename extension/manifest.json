{
  "manifest_version": 3,
  "name": "My First Extension",
  "description": "Shows a simple popup when you click the icon",
  "version": "1.0",
  "icons": {
    "48": "icon.png",
    "128": "icon.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "permissions": []
}