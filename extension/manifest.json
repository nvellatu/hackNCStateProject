{
  "manifest_version": 3,
  "name": "Streetlight Ledger - AI Classify",
  "version": "1.0.0",
  "description": "Analyzes cookie risks with Gemini 3 Flash AI.",
  "permissions": ["tabs", "webRequest", "cookies", "storage"],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html"
  },
  "icons": {
    "128": "DetectiveCookie.png"
  }
}